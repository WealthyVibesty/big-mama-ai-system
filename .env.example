# Big Mama AI system environment template.
# Copy to .env and fill in real values. Never commit a filled .env.
# No credential is hardcoded anywhere in this repo.

# Supabase (Project settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login for /admin.
# When Supabase is configured, /admin uses Supabase Auth instead.
# These env credentials are the local/demo gate only.
VITE_ADMIN_EMAIL=admin@yourdomain.com
VITE_ADMIN_PASSWORD=

# Stripe (TEST MODE keys until you are ready to go live)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Resend (transactional email + welcome sequence)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Wealthy Vibes Ty <hello@wealthyvibesty.com>

# AI Response Agent (edge function: draft-ai-reply)
OPENAI_API_KEY=

# Twilio (SMS in the unified inbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Gmail OAuth (setup wizard step 1)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# ElevenLabs voice widget (website, bottom right)
VITE_ELEVENLABS_AGENT_ID=

# Booking embed (Cal.com)
VITE_CAL_LINK=

# Analytics slots
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# Organization used by public forms before a user session exists
VITE_DEFAULT_ORGANIZATION_ID=
